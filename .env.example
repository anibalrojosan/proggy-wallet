# --- DATABASE CONFIGURATION ---
DB_USER=postgres
DB_PASSWORD=your_password_here # Change to your own password
DB_NAME=proggy_wallet
DB_HOST=localhost
DB_PORT=5432 # Default PostgreSQL port, can be changed if needed
# The full connection URL (constructed using the fields above)
# Format: postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_URL=postgresql://postgres:your_password_here@localhost:5432/proggy_wallet

# --- Django configuration ---
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=your-super-secret-key-here-change-it
DEBUG=True

# --- API CONFIGURATION ---
API_HOST=0.0.0.0
API_PORT=8000

